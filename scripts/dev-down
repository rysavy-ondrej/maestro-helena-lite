#!/usr/bin/env bash
# Stop what scripts/dev-up started. Leaves .rwdata alone - that is the store.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

stop() {  # name pidfile
    local name="$1" pidfile="$2" pid
    if [ ! -f "$pidfile" ]; then
        echo "dev-down: no $name pidfile; nothing to stop"
        return
    fi
    pid="$(cat "$pidfile")"
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "dev-down: $name (pid $pid) was not running"
        rm -f "$pidfile"
        return
    fi
    kill "$pid"
    for _ in $(seq 1 40); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.5
    done
    if kill -0 "$pid" 2>/dev/null; then
        echo "dev-down: $name (pid $pid) ignored SIGTERM after 20s; sending SIGKILL" >&2
        kill -9 "$pid"
    fi
    rm -f "$pidfile"
    echo "dev-down: stopped $name (pid $pid)"
}

stop engine "$ROOT/.run/risingwave.pid"
stop broker "$ROOT/.run/blink.pid"
