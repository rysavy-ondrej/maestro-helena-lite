# HELENA configuration. Copy to `.env` and fill in; `.env` is never committed.
#
# Every variable this project reads is listed here, with an empty value. An
# empty or whitespace-only value counts as MISSING: a copied-but-unfilled file
# fails at startup naming the variable, rather than sending an empty token to a
# real service or running against a built-in default endpoint. There are no
# built-in defaults.
#
# `tests/test_config.py` asserts that this file and `helena.config.VARIABLES`
# list exactly the same names, so a variable added to one and not the other is a
# test failure.
#
# Never copy a value from `.env` into this file.

# --- Model settings, general -------------------------------------------------
# The OpenAI-compatible endpoint every agent runs against. Required.
LLM_URL=
LLM_TOKEN=
LLM_MODEL=

# --- Model settings, per agent -----------------------------------------------
# Optional overrides. Resolution is agent-specific, then general, then fail —
# never a fallback to the other agent's model. Leave one empty to use the
# general value above; there is no other way to get a default.
LLM_URL_TRIAGE=
LLM_TOKEN_TRIAGE=
LLM_MODEL_TRIAGE=
LLM_URL_ANALYST=
LLM_TOKEN_ANALYST=
LLM_MODEL_ANALYST=

# --- Ingestion identity ------------------------------------------------------
# Stamped on every event by the normalizer; the flow record carries neither.
# Required, and deliberately without a default: a tenant that silently defaults
# is an isolation failure that looks like it is working.
HELENA_TENANT=
HELENA_SENSOR=

# Which input format this deployment consumes, naming one of the adapters
# registered in `helena.normalizer` (`flow-json` is the format the sample
# capture is in). A second format is an adapter and a change to this line, never
# a change to a contract. Required, and without a default: a deployment reading
# its traffic through the wrong parser would quarantine every record.
HELENA_INPUT_FORMAT=

# --- Provider credentials ----------------------------------------------------
# Held by the tool layer. Agents never see one. The abuse.ch key goes in an
# `Auth-Key` header; the bulk export needs no credential at all (measured
# 2026-09-03). Any credential that does reach a URL must be redacted before
# anything is logged, stored or recorded as provenance.
ABUSECH_AUTH_KEY=
VIRUSTOTAL_AUTH_KEY=

# --- Infrastructure addresses ------------------------------------------------
# The streaming engine over the PostgreSQL wire protocol, and the broker over
# the Kafka wire protocol. Addresses, not credentials.
RISINGWAVE_DSN=
KAFKA_BOOTSTRAP_SERVERS=

# The topic flow records arrive on, over the Kafka wire protocol. A name, not an
# address, and required for the same reason the address is: a deployment reading
# a misspelled topic waits forever on one nobody produces to, which looks exactly
# like a producer that stopped. The output topic is not here yet — it enters with
# the sink that writes to it.
HELENA_INGEST_TOPIC=
