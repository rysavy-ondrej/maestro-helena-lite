#!/usr/bin/env bash
# Bring the pinned engine and broker up, then run one of the demos.
#
#   demo/run-demo                    run demo 1, leaving the engine and broker up
#   demo/run-demo 2                  run demo 2 instead
#   demo/run-demo context_over_a_day ... by name, as well as by number
#   demo/run-demo --down 2           ... and stop them again afterwards
#   demo/run-demo 2 -- --files 12    everything after -- goes to the demo itself
#   demo/run-demo --list             what there is to run
#
# Process management is scripts/dev-up's job, not this script's: it verifies the
# binaries against docs/versions.md and refuses to start anything that does not
# match. This only sequences it with the demo.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# The shipped demos, in the order docs/demos.md numbers them. That table is the
# index and this list is held equal to it by tests/test_demos.py, so a demo added
# to one and not the other is a test failure rather than a thing a reader finds
# by running --list and being surprised.
DEMOS=(ingest_and_context context_over_a_day assess_a_slice enrichment_states
       escalation_and_scope failure_paths replay_an_assessment backup_and_restore
       assess_an_infection)

# The comment block at the top of this file, minus the leading '#', is the help.
usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"; }

list() {
    local i
    for i in "${!DEMOS[@]}"; do
        printf '  %d  demo/%s.py\n' "$((i + 1))" "${DEMOS[i]}"
    done
    printf '\n  %s\n' "docs/demos.md is the index: what each shows, what data it"
    printf '  %s\n' "needs, and which situation each one is for."
}

# A selector is a 1-based number or a script name, with or without the .py.
resolve() {
    local want="${1%.py}" i
    if [[ "$want" =~ ^[0-9]+$ ]]; then
        [ "$want" -ge 1 ] && [ "$want" -le "${#DEMOS[@]}" ] || return 1
        printf '%s' "${DEMOS[want - 1]}"
        return 0
    fi
    for i in "${!DEMOS[@]}"; do
        if [ "$want" = "${DEMOS[i]}" ]; then printf '%s' "${DEMOS[i]}"; return 0; fi
    done
    return 1
}

STOP_AFTER=0
DEMO="${DEMOS[0]}"
DEMO_ARGS=()

while [ $# -gt 0 ]; do
    case "$1" in
        --down) STOP_AFTER=1 ;;
        --list) list; exit 0 ;;
        -h|--help) usage; exit 0 ;;
        --) shift; DEMO_ARGS=("$@"); break ;;
        -*) echo "run-demo: unknown option $1" >&2; usage >&2; exit 2 ;;
        *)
            DEMO="$(resolve "$1")" || {
                echo "run-demo: no such demo: $1" >&2
                list >&2
                exit 2
            }
            ;;
    esac
    shift
done

scripts/dev-up || true          # says so and exits non-zero if already running

status=0
uv run "demo/$DEMO.py" ${DEMO_ARGS+"${DEMO_ARGS[@]}"} || status=$?

[ "$STOP_AFTER" -eq 1 ] && scripts/dev-down
exit "$status"
